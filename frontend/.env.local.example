# Demo wallet shown in UI hints (not used for signing)
NEXT_PUBLIC_DEMO_WALLET=0x0000000000000000000000000000000000000000

# Address that has been pre-approved as a spender on the demo proxy
NEXT_PUBLIC_DEMO_SPENDER=0x0000000000000000000000000000000000000000

# Demo proxy per chain. Sepolia is the deployed demo target; mainnet is intentionally empty.
NEXT_PUBLIC_DEMO_PROXY_BASE_SEPOLIA=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DEMO_PROXY_BASE=

# Swarm feed URL the dashboard reads alerts from (server-side fetch).
# The agent prints this on startup as `${BZZ_LIMO}/feeds/${ownerAddress}/${topicHex}`.
# Leave empty to disable Swarm and rely on the local files / seed / mock fallback.
SWARM_FEED_URL=

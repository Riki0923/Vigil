# Chain: Base Sepolia (testnet) — swap for Base Mainnet when going live
RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY

POLL_INTERVAL_MS=30000

OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
APIFY_API_KEY=your_apify_api_key
SPACECOMPUTER_API_KEY=your_spacecomputer_api_key
SWARM_BEE_URL=your_swarm_bee_url
SWARM_POSTAGE_STAMP=your_swarm_postage_stamp
# Pin SWARM_PRIVATE_KEY so the bzz.limo feed URL is stable across restarts —
# subscribers discover it via the `vigil.feed` text record on agent.vigil.eth
# (run `npm run ens:sync-feed` whenever the key rotates).
SWARM_PRIVATE_KEY=your_32_byte_hex_private_key

# ENS — vigil.eth and subnames live on Ethereum Sepolia (chain id 11155111).
# The agent reads its identity from agent.vigil.eth at boot; demo.vigil.eth maps
# to the demo proxy on Base Sepolia via ENSIP-11 multichain address records.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
VIGIL_PARENT_ENS_NAME=vigil.eth
VIGIL_AGENT_ENS_NAME=agent.vigil.eth

# ENS on Ethereum mainnet (chain id 1) — production parent name.
# Pass --network=mainnet to scripts/ens/* to target this network. The same
# ENS_REGISTRAR_PRIVATE_KEY signs both Sepolia and mainnet writes.
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
VIGIL_PARENT_ENS_NAME_MAINNET=vigilbot.eth
# Required only for write ops (ens:seed, ens:set-base-primary). The wallet must own vigil.eth on Sepolia.
ENS_REGISTRAR_PRIVATE_KEY=
# Used by ens:set-base-primary to call the L2 ReverseRegistrar on Base Sepolia.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_PRIVATE_KEY=
# L2ReverseRegistrar on Base Sepolia (verified against ensdomains/ens-contracts/deployments/baseSepolia/L2ReverseRegistrar.json)
BASE_SEPOLIA_REVERSE_REGISTRAR=0x00000BeEF055f7934784D6d81b6BC86665630dbA

# Base mainnet — used by ens:set-base-primary --network=base-mainnet for the
# ENSIP-19 reverse on the production demo proxy.
BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
BASE_MAINNET_PRIVATE_KEY=

# Agent runtime ENS network — "sepolia" reads from agent.vigil.eth, "mainnet"
# reads from agent.vigilbot.eth. Defaults to sepolia for backward compatibility.
VIGIL_ENS_NETWORK=sepolia
